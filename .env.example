APP_ENV=local
APP_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://legalai:legalai-dev@localhost:5442/legalai
SESSION_SECRET=            # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false        # true in staging/production

STORAGE_DIR=./data/storage
RUN_WORKER=true            # job worker runs inside the API process (one service owns the volume)
MAX_UPLOAD_MB=50

VECTOR_STORE=pgvector
LLM_PRIMARY_PROVIDER=local_gpu
LLM_FALLBACK_PROVIDER=disabled     # disabled | openai_compatible
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
EXTERNAL_LLM_MONTHLY_BUDGET_USD=0
EXTERNAL_LLM_PRICE_PER_1K_TOKENS_USD=0

GPU_NODE_URL=              # e.g. https://gpu.example.com (tunnel hostname)
GPU_NODE_TOKEN=            # shared secret, also set on the GPU node
GPU_NODE_ID=home-5070ti

FAST_MODEL=qwen3:14b
DEEP_MODEL=qwen3:30b
CRITIC_MODEL=qwen3:14b
EXTRACTION_MODEL=qwen3:14b

EMBEDDING_PROVIDER=external        # external | local
EMBEDDING_API_KEY=                 # Voyage key
EMBEDDING_MODEL=voyage-law-2
EMBEDDING_MONTHLY_BUDGET_USD=

DEFAULT_PRIVACY_MODE=private
