{
  "name": "founderos-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for FounderOS. Standalone package: not an npm workspace, so the root lockfile is untouched.",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
